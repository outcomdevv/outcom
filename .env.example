# ---------- Public app ----------
NEXT_PUBLIC_APP_URL=https://your-outcom-domain.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=...

# Encrypt provider credentials and workspace AI keys. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OUTCOM_TOKEN_ENCRYPTION_KEY=

# Background observer authentication. Use the same secret in Cloudflare Worker.
OUTCOM_CRON_SECRET=

# ---------- OAuth providers ----------
# HighLevel
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_REDIRECT_URI=https://your-outcom-domain.vercel.app/api/oauth/ghl/callback
GHL_OAUTH_SCOPES=contacts.readonly locations.readonly

# Make
MAKE_CLIENT_ID=
MAKE_CLIENT_SECRET=
MAKE_REDIRECT_URI=https://your-outcom-domain.vercel.app/api/oauth/make/callback
MAKE_OAUTH_SCOPES=openid scenarios:read organization:read user:read teams:read
MAKE_API_ZONES=eu1,eu2,us1,us2

# Zapier Powered by Zapier / Workflow API
ZAPIER_CLIENT_ID=
ZAPIER_CLIENT_SECRET=
ZAPIER_REDIRECT_URI=https://your-outcom-domain.vercel.app/api/oauth/zapier/callback
ZAPIER_OAUTH_SCOPES=profile zap:all

# ---------- Optional provider tuning ----------
GHL_API_BASE_URL=https://services.leadconnectorhq.com
GHL_TIMEOUT_MS=8000
