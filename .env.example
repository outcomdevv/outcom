# Public app URL used for OAuth callbacks and private inbound webhook URLs.
NEXT_PUBLIC_APP_URL=https://your-domain.example

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only: use SUPABASE_SECRET_KEY when available; legacy projects may use SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=...
SUPABASE_SERVICE_ROLE_KEY=...

# 32 random bytes encoded as 64 hex characters (server-only).
# Used to encrypt provider tokens and inbound webhook URL tokens at rest.
OUTCOM_TOKEN_ENCRYPTION_KEY=64_HEX_CHARS

# Optional HighLevel tuning / OAuth
GHL_API_BASE_URL=https://services.leadconnectorhq.com
GHL_TIMEOUT_MS=8000
GHL_AUTHORIZE_URL=https://marketplace.gohighlevel.com/oauth/chooselocation
GHL_OAUTH_SCOPES=contacts.readonly locations.readonly
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_REDIRECT_URI=https://your-domain.example/api/oauth/ghl/callback

# Optional Make OAuth. Manual API-token and webhook modes work without these.
MAKE_API_BASE_URL=https://eu1.make.com/api/v2
MAKE_API_ZONES=eu1,eu2,us1,us2
MAKE_OAUTH_SCOPES=openid scenarios:read organization:read user:read teams:read
MAKE_CLIENT_ID=
MAKE_CLIENT_SECRET=
MAKE_REDIRECT_URI=https://your-domain.example/api/oauth/make/callback

# Optional Zapier OAuth. Webhook mode works without these.
ZAPIER_OAUTH_SCOPES=profile zap:all
ZAPIER_CLIENT_ID=
ZAPIER_CLIENT_SECRET=
ZAPIER_REDIRECT_URI=https://your-domain.example/api/oauth/zapier/callback

# Optional observer secret / worker URL if using the Cloudflare observer.
OUTCOM_CRON_SECRET=
OUTCOM_APP_URL=https://your-domain.example
